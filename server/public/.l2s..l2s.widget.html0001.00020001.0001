<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>在线客服</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, "PingFang SC", "Microsoft YaHei", sans-serif; background: #f2f4f8; color: #222; }
  .wrap { max-width: 640px; margin: 0 auto; min-height: 100vh; display: flex; flex-direction: column; }
  .head { background: #4d6bfe; color: #fff; padding: 16px 20px; }
  .head h1 { font-size: 18px; }
  .head .sub { font-size: 12px; opacity: .85; margin-top: 4px; }
  .body { flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; }
  .msg { max-width: 78%; padding: 10px 14px; border-radius: 12px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; font-size: 14px; }
  .msg.user { align-self: flex-end; background: #4d6bfe; color: #fff; border-bottom-right-radius: 4px; }
  .msg.assistant { align-self: flex-start; background: #fff; border: 1px solid #e3e7f0; border-bottom-left-radius: 4px; }
  .msg .who { font-size: 11px; color: #8b96ad; margin-bottom: 4px; }
  .input { display: flex; gap: 10px; padding: 12px; background: #fff; border-top: 1px solid #e3e7f0; }
  .input textarea { flex: 1; resize: none; height: 52px; padding: 10px; border: 1px solid #d5dbe8; border-radius: 8px; font: inherit; outline: none; }
  .input button { padding: 0 20px; border: 0; border-radius: 8px; background: #4d6bfe; color: #fff; font-size: 14px; cursor: pointer; }
  .input button:disabled { opacity: .5; }
  .tip { text-align: center; color: #8b96ad; font-size: 12px; padding: 8px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="head">
    <h1 id="merchant">在线客服</h1>
    <div class="sub" id="agent">正在连接…</div>
  </div>
  <div class="body" id="body"></div>
  <div class="input">
    <textarea id="input" placeholder="请输入您的问题…"></textarea>
    <button id="send">发送</button>
  </div>
  <div class="tip">DSH 客服平台 · 网页问答组件（v1）</div>
</div>
<script>
(function () {
  var token = location.pathname.split("/").filter(Boolean).pop();
  var base = "/kefu/api/widget/" + token;
  var visitorId = localStorage.getItem("kefu_visitor") || Math.random().toString(36).slice(2, 12);
  localStorage.setItem("kefu_visitor", visitorId);
  var body = document.getElementById("body");
  var input = document.getElementById("input");
  var sendBtn = document.getElementById("send");
  var busy = false;

  function add(role, text) {
    var div = document.createElement("div");
    div.className = "msg " + role;
    var who = document.createElement("div");
    who.className = "who";
    who.textContent = role === "user" ? "我" : (document.getElementById("agent").textContent.split("·")[0].trim() || "客服");
    div.appendChild(who);
    var span = document.createElement("span");
    span.textContent = text;
    div.appendChild(span);
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
    return span;
  }

  fetch(base + "/config").then(function (r) { return r.json(); }).then(function (d) {
    if (d.error) throw new Error(d.error.message);
    document.getElementById("merchant").textContent = d.data.merchantName;
    document.getElementById("agent").textContent = d.data.agentName + " · " + (d.data.tierName || "智能客服");
    if (d.data.welcomeMessage) add("assistant", d.data.welcomeMessage);
  }).catch(function (e) {
    document.getElementById("agent").textContent = "客服组件不可用";
    add("assistant", "客服暂时无法接入：" + e.message);
  });

  function send() {
    var content = input.value.trim();
    if (!content || busy) return;
    busy = true;
    sendBtn.disabled = true;
    input.value = "";
    add("user", content);
    var pending = add("assistant", "…");
    fetch(base + "/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ content: content, visitorId: visitorId })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (d.error) throw new Error(d.error.message);
      pending.textContent = d.data.message.content;
    }).catch(function (e) {
      pending.textContent = "抱歉，回复失败：" + e.message;
    }).finally(function () {
      busy = false;
      sendBtn.disabled = false;
      body.scrollTop = body.scrollHeight;
    });
  }
  sendBtn.onclick = send;
  input.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); } });
})();
</script>
</body>
</html>
